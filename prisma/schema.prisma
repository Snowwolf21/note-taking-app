// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String?
  fontTheme           String               @default("sans") // "sans", "serif", "monospace"
  colorTheme          String               @default("dark") // "dark", "light", "sepia", "slate"
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  notes               Note[]
  passwordResetTokens PasswordResetToken[]
}

model Note {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  isArchived Boolean  @default(false)
  tags       String   @default("[]") // JSON stringified array of tag strings
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
